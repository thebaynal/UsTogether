{
  "name": "ustogether",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "web": "npm run web -w client",
    "android": "npm run android -w client",
    "ios": "npm run ios -w client",
    "build": "npm run build -w client && node scripts/verify-export.mjs",
    "typecheck": "npm run typecheck -w client",
    "test": "npm run test -w client",
    "test:e2e:typecheck": "tsc --noEmit -p e2e/tsconfig.json",
    "test:e2e": "npm run test:e2e:typecheck && playwright test",
    "test:deploy": "node --test scripts/deploy.test.mjs"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
